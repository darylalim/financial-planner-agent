# Copy to .env and fill in. .env is gitignored.

# Required. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Without it, web search is disabled and the agent is instructed not
# to state current-year tax or contribution limits from memory.
# https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Optional. Any provider-prefixed string langchain's init_chat_model accepts.
# The default is config.DEFAULT_MODEL. To go back to the previous model, keeping
# the rest of the setup, use anthropic:claude-opus-5 (README -> The model).
# FINANCIAL_PLANNER_MODEL=anthropic:claude-opus-5

# Optional. The model of the document-reader, the subagent that reads PDF text
# (README -> The document-reader quarantine). Defaults to config.READER_MODEL:
# Sonnet 5.5 under an Anthropic main model, or the main model otherwise.
# FINANCIAL_PLANNER_READER_MODEL=anthropic:claude-sonnet-5-5

# Optional. Relocates the agent's filesystem root. Defaults to ./agent_home.
# scripts/live_check.py sets this to a temp directory so a live run cannot
# overwrite your real profile.
# FINANCIAL_PLANNER_HOME=/path/to/agent_home

# Optional. Tracing at https://smith.langchain.com -- very useful for seeing
# which tools the agent actually called and why.
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=financial-planner-agent
